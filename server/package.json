{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile src/db/knexfile.ts",
    "migrate:make": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile src/db/knexfile.ts",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile src/db/knexfile.ts",
    "seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile src/db/knexfile.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "knex": "^3.2.10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  }
}
